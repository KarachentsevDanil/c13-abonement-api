          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{ticket=~\"$ticket\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "time_series"
