{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/unit-on-stop.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@abonement-course": true
  },
  "extraKnownMarketplaces": {
    "abonement-course": {
      "source": {
        "source": "settings",
        "name": "abonement-course",
        "plugins": [
          {
            "name": "superpowers",
            "source": {
              "source": "github",
              "repo": "obra/superpowers",
              "sha": "bb92a77741419a4ab5f06e711a283343f1ada0c3"
            }
          }
        ]
      }
    }
  }
}
